#!/usr/bin/env bash
# ws-send-follow <SLOT|next|prev> — send focused window to target
# workspace and follow it. Loud failure if no window is focused or the
# target workspace doesn't exist. Post-Phase-6 wrapper around aerospace's
# move-node-to-workspace; slot index is resolved to a workspace name via
# aerospace's `list-workspaces --all --json` ordering.
set -u

# Resolve the sibling lib/ directory relative to this script's own real
# location. `ws-send-follow` is symlinked into ~/.local/bin (see
# install.sh), so BASH_SOURCE[0] is the symlink — resolve it first (macOS
# 14+ ships `readlink -f`). Falls back to the legacy
# ~/.config/workspace/lib path when the self-relative file doesn't exist.
WS_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
if [[ -r "$WS_ROOT/lib/config.sh" ]]; then
  # shellcheck source=/dev/null
  source "$WS_ROOT/lib/config.sh"
elif [[ -r "$HOME/.config/workspace/lib/config.sh" ]]; then
  # shellcheck source=/dev/null
  source "$HOME/.config/workspace/lib/config.sh"
fi

have() { command -v "$1" >/dev/null 2>&1; }
have jq || { echo "ws-send-follow: jq is required (brew install jq)" >&2; exit 1; }

# Notify via argv-passed osascript — never splice data into the AppleScript
# source (that's an injection vector: a workspace/slot name containing a
# quote or backslash could break out of the string literal).
_notify() {
  local msg="$1" title="${2:-ws}"
  osascript -e 'on run argv' \
            -e 'display notification (item 1 of argv) with title (item 2 of argv)' \
            -e 'end run' \
            -- "$msg" "$title" 2>/dev/null
}

if [[ ! -x "${WORKSPACE_WM_BIN:-}" ]]; then
  _notify "aerospace not found (set WORKSPACE_WM_BIN or install aerospace)"
  exit 1
fi

target="${1:-}"
[[ -n "$target" ]] || {
  _notify "ws-send-follow: missing slot arg"
  exit 2
}

# Refuse to act if there is no focused window — move-node-to-workspace
# is a silent no-op in that case, which lets users think they moved
# something when they didn't.
win=$("$WORKSPACE_WM_BIN" list-windows --focused --json 2>/dev/null \
        | jq -r '.[0]."window-id" // empty' 2>/dev/null)
if [[ -z "$win" ]]; then
  _notify "no focused window"
  exit 1
fi

# Aerospace's `move-node-to-workspace next|prev` already exists; pass
# those through directly and let aerospace handle the wraparound + focus.
if [[ "$target" == "next" || "$target" == "prev" ]]; then
  # AeroSpace v0.20+ requires explicit --no-stdin (or --stdin) when
  # invoked non-interactively; otherwise it bails with "Implicit stdin
  # is detected".
  if ! "$WORKSPACE_WM_BIN" move-node-to-workspace --focus-follows-window --wrap-around --no-stdin "$target" 2>/dev/null; then
    _notify "send $target failed"
    exit 1
  fi
  exit 0
fi

# Numeric slot → resolve to workspace name via aerospace's ordered list.
# spaces.json composite-key order matches aerospace's monitor-grouped
# order under fork B, so the N-th entry is the chord target.
all=$("$WORKSPACE_WM_BIN" list-workspaces --all --json 2>/dev/null)
if [[ -z "$all" ]]; then
  _notify "aerospace unavailable"
  exit 1
fi
count=$(jq 'length' <<<"$all")
if [[ ! "$target" =~ ^[0-9]+$ ]] || (( target < 1 || target > count )); then
  _notify "slot $target does not exist (have $count)"
  exit 1
fi
name=$(jq -r --argjson n "$target" '.[$n - 1].workspace' <<<"$all")
[[ -z "$name" || "$name" == "null" ]] && {
  _notify "slot $target has no workspace name"
  exit 1
}

if ! "$WORKSPACE_WM_BIN" move-node-to-workspace --focus-follows-window "$name" 2>/dev/null; then
  _notify "send to $name failed"
  exit 1
fi
